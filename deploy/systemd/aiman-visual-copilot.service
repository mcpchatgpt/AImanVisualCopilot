[Unit]
Description=AImanVisualCopilot Observer MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=avc
Group=avc
WorkingDirectory=/opt/aiman-visual-copilot/app
EnvironmentFile=/etc/aiman-visual-copilot.env
ExecStart=/opt/aiman-visual-copilot/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8391 --workers 1 --proxy-headers --no-access-log
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aiman-visual-copilot
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
