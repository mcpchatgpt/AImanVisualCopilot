[Unit]
Description=AImanVisualCopilot Budgeted Visual Memory Worker
After=aiman-visual-copilot.service

[Service]
Type=oneshot
User=avc
Group=avc
WorkingDirectory=/opt/aiman-visual-copilot/app
EnvironmentFile=/etc/aiman-visual-copilot.env
ExecStart=/opt/aiman-visual-copilot/venv/bin/python /opt/aiman-visual-copilot/scripts/vision_worker.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aiman-visual-copilot
