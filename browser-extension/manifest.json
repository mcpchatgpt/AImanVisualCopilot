{
  "manifest_version": 3,
  "name": "AImanVisualCopilot Browser Bridge",
  "version": "0.2.0",
  "description": "Read-only browser semantic and developer-observer bridge for AImanVisualCopilot.",
  "permissions": [
    "tabs",
    "windows",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file://*/*",
    "__AVC_SERVER__/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "dev-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "dev-main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "AImanVisualCopilot Browser Bridge"
  }
}
